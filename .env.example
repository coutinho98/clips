OPENAI_API_KEY=sk-sua-chave-aqui
PEXELS_API_KEY=sua-chave-pexels-aqui
NICHO=curiosidades_sombrias
VOZ=pt-BR-AntonioNeural
QUANTIDADE_IMAGENS=6
DURACAO_IMAGEM_SEGUNDOS=8
RESOLUCAO=1080x1920

# Ollama (IA Local - Llama 3.2)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Live Clipper
WHISPER_METODO=local
WHISPER_MODELO=medium
LIVE_CLIPPER_MAX_CORTES=5
LIVE_CLIPPER_DURACAO_MIN=30
LIVE_CLIPPER_DURACAO_MAX=90
LIVE_CLIPPER_CROP_VERTICAL=true
LIVE_CLIPPER_LEGENDAS=false
LIVE_CLIPPER_ESTILO_LEGENDAS=neon
LIVE_CLIPPER_DETECTAR_POR=ia

# Instagram Upload (opcional)
IG_USER_ID=
IG_ACCESS_TOKEN=

# Postagem automática (cron)
# Plataformas que o postar.py vai usar (separadas por vírgula)
POSTAR_PLATAFORMAS=youtube,tiktok
POSTAR_MAX_RETRY=3

# YouTube Shorts (OAuth)
# Baixe o OAuth Client ID (tipo 'Desktop app') em:
# https://console.cloud.google.com/apis/credentials
# Habilite a 'YouTube Data API v3' e salve o JSON em secrets/client_secret.json
YOUTUBE_CATEGORIA=22
YOUTUBE_PRIVACY=public

# TikTok (Content Posting API v2)
# Crie o app em https://developers.tiktok.com → Basic settings
# client_key/secret vão aqui; depois rode: python postar.py --auth-tiktok
# O access_token é salvo em secrets/tiktok_token.json e renovado sozinho.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:9876/callback
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE
# (opcional) token fixo sem renovação — expira em 24h
TIKTOK_ACCESS_TOKEN=
